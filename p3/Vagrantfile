Vagrant.configure("2") do |config|
  # ==========================================
  # CONFIGURACIÓN CROSS-PLATFORM (LINUX vs MAC M4)
  # ==========================================
 
  BOX            = "bento/ubuntu-26.04"
  SERVER_VM_NAME = "mlezcanoS"
  SERVER_IP      = "192.168.56.112"

  is_mac_arm = RUBY_PLATFORM =~ /arm64/ || RUBY_PLATFORM =~ /aarch64/ ||
               (RUBY_PLATFORM =~ /darwin/ && `uname -m`.strip == 'arm64')

  provider = is_mac_arm ? (ENV['VAGRANT_DEFAULT_PROVIDER'] || "vmware_desktop") : "virtualbox"

  config.vm.box = BOX

  # ==========================================
  # CONFIGURACIÓN GLOBAL (Especificaciones de CPU y RAM)
  # ==========================================
  # K3d + Docker + Argo CD necesitan más recursos que K3s a pelo (p1/p2), por eso
  # el mínimo aquí es mayor, y configurable vía ENV (P3_MEMORY / P3_CPUS) por si hiciera falta más
  # (por ejemplo, para encadenar el bonus con GitLab sobre esta misma VM).
  memory = (ENV['P3_MEMORY'] || 8192).to_i	# Si solo decidimos levantar hasta p3, se puede dejar en 2048 
  cpus   = (ENV['P3_CPUS']   || 3).to_i		# Si solo decidimos levantar hasta p3, se puede dejar en 2

  config.vm.provider provider do |v|
    if provider == "vmware_desktop"
      v.vmx["memsize"] = memory.to_s
      v.vmx["numvcpus"] = cpus.to_s
      v.vmx["cpuid.coresPerSocket"] = "1" # Evita problemas de arranque con VMware
    else
      v.memory = memory
      v.cpus = cpus
    end
  end

  # ==========================================
  # MÁQUINA ÚNICA: (wrapper k3d)
  # ==========================================
  config.vm.define SERVER_VM_NAME do |server|
    server.vm.hostname = SERVER_VM_NAME
    server.vm.network "private_network", ip: SERVER_IP
    server.vm.network "forwarded_port", guest: 8888, host: 8888, host_ip: "127.0.0.1", auto_correct: false
    server.vm.network "forwarded_port", guest: 8080, host: 8080, host_ip: "127.0.0.1", auto_correct: false

    server.vm.provider provider do |v|
      provider == "vmware_desktop" ? v.vmx["displayname"] = "#{SERVER_VM_NAME}_p3" : v.name = "#{SERVER_VM_NAME}_p3"
    end

    server.vm.synced_folder "../bonus", "/bonus", create: true

    # Provisionamiento: Ejecutamos el script de instalación con privilegios de administrador.
    server.vm.provision "shell", path: "scripts/install.sh", privileged: true
  end
end
